@startuml C4_Context_Diagram_Rates_Integration

!includeurl https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

Person(оператор, "Оператор колл-центра", "Консультирует клиентов по ставкам")
Person(клиент_сущ, "Клиент банка", "Существующий клиент с доступом в интернет-банк")
Person(клиент_нов, "Новый клиент", "Клиент без учетной записи в банке")

System(интернет_банк, "Интернет-банк", "ASP.NET MVC 4.5, MS SQL\nВеб-приложение для существующих клиентов")
System(сайт, "Сайт банка", "PHP + React.js\nПубличный сайт для новых клиентов")
System(абс, "АБС", "Delphi + Oracle + PL-SQL\nОсновная банковская система")
System(колл_центр, "Система колл-центра", "Java Spring Boot + React.js + PostgreSQL")
System(сервис_депозитов, "Сервис депозитов", "Java Spring Boot\nБуферизация запросов, управление ставками")
System(смс, "СМС-шлюз", "Сервис отправки СМС уведомлений")

System(партнерский_кц, "Партнерский колл-центр", "Внешняя информационная система\nГотовы получать ставки в виде файлов")
System(sftp_сервер, "SFTP-сервер", "Безопасная передача файлов партнерам")

Rel(клиент_сущ, интернет_банк, "Подает заявки на депозиты", "HTTPS")
Rel(клиент_нов, сайт, "Оставляет заявку на депозит", "HTTPS")
Rel(клиент_сущ, оператор, "Консультируется по ставкам", "Телефон")
Rel(клиент_нов, оператор, "Консультируется по ставкам", "Телефон")

Rel(оператор, колл_центр, "Просматривает актуальные ставки", "Web UI")
Rel(интернет_банк, сервис_депозитов, "Получает ставки для отображения", "REST API")
Rel(сайт, сервис_депозитов, "Получает ставки для отображения", "REST API")
Rel(колл_центр, сервис_депозитов, "Получает актуальные ставки", "REST API")

Rel(сервис_депозитов, абс, "Синхронизирует изменения ставок", "JDBC/PL-SQL")
Rel(сервис_депозитов, sftp_сервер, "Размещает файлы со ставками", "SFTP")
Rel(sftp_сервер, партнерский_кц, "Предоставляет файлы для загрузки", "SFTP")

Rel(интернет_банк, смс, "Запросы на отправку СМС", "API")
Rel(абс, смс, "Отправка уведомлений", "API")
Rel(смс, клиент_сущ, "СМС уведомления", "SMS")
Rel(смс, клиент_нов, "СМС уведомления", "SMS")

@enduml