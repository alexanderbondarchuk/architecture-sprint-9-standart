@startuml C4_Container_Diagram_Deposit_MVP

!includeurl https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
!includeurl https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

Person(клиент_сущ, "Клиент банка", "Существующий клиент")
Person(клиент_нов, "Новый клиент", "Клиент без учетной записи")
Person(менеджер, "Менеджер бэк-офиса", "Обрабатывает заявки")
Person(оператор, "Оператор колл-центра", "Обрабатывает заявки с сайта")
Person(сотрудник, "Сотрудник отделения", "Оформляет в отделении")

System_Boundary(интернет_банк_система, "Интернет-банк") {
    Container(веб_иб, "Веб-приложение ИБ", "ASP.NET MVC 4.5", "Представление депозитов, подача заявок, СМС-подтверждение")
    Container(бд_иб, "База данных ИБ", "MS SQL", "Хранение данных сессий, кэширование ставок")
}

System_Boundary(сайт_система, "Сайт банка") {
    Container(веб_сайт, "Веб-сайт", "PHP + React.js", "Форма заявки для новых клиентов")
    Container(бд_сайт, "База данных сайта", "MySQL", "Временное хранение заявок")
}

System_Boundary(абс_система, "АБС") {
    Container(клиент_абс, "Клиент АБС", "Delphi", "Десктопное приложение для сотрудников")
    Container(бд_абс, "База данных АБС", "Oracle", "Основные банковские данные")
    Container(api_абс, "API АБС", "PL-SQL", "Процедуры для интеграции")
}

System_Boundary(колл_центр_система, "Система колл-центра") {
    Container(веб_кц, "Веб-интерфейс КЦ", "React.js", "Интерфейс оператора")
    Container(бэкенд_кц, "Бэкенд сервисы", "Java Spring Boot", "Обработка заявок, управление звонками")
    Container(бд_кц, "База данных КЦ", "PostgreSQL", "Хранение заявок и истории взаимодействий")
}

Container(сервис_депозитов, "Сервис депозитов", "Java Spring Boot", "Буферизация запросов, управление ставками\nИзоляция нагрузки на АБС")
Container(смс_шлюз, "СМС-шлюз", "REST API", "Интеграция с телеком-оператором")

' Relationships
Rel(клиент_сущ, веб_иб, "Работает с депозитами", "HTTPS")
Rel(клиент_нов, веб_сайт, "Оставляет заявку", "HTTPS")
Rel(менеджер, клиент_абс, "Обрабатывает заявки", "LAN")
Rel(оператор, веб_кц, "Работает с заявками", "HTTPS")
Rel(сотрудник, клиент_абс, "Оформляет депозиты", "LAN")

Rel(веб_иб, бд_иб, "Чтение/запись", "ADO.NET")
Rel(веб_сайт, бд_сайт, "Сохранение заявок", "PDO")
Rel(клиент_абс, бд_абс, "Операции с данными", "Oracle Client")
Rel(бэкенд_кц, бд_кц, "Чтение/запись", "JDBC")

' Критические интеграции
Rel(веб_иб, сервис_депозитов, "Передача заявок, получение ставок", "REST API")
Rel(сервис_депозитов, api_абс, "Синхронизация заявок и продуктов", "JDBC/PL-SQL")
Rel(веб_сайт, бэкенд_кц, "Передача заявок с сайта", "REST API")
Rel(бэкенд_кц, сервис_депозитов, "Передача подтвержденных заявок", "REST API")

' СМС интеграции
Rel(веб_иб, смс_шлюз, "Запрос СМС-подтверждения", "REST API")
Rel(api_абс, смс_шлюз, "Уведомления о статусе заявки", "REST API")
Rel(смс_шлюз, клиент_сущ, "СМС с кодом подтверждения", "SMS")
Rel(смс_шлюз, клиент_нов, "СМС о статусе заявки", "SMS")

' Внутренние интеграции АБС
Rel(клиент_абс, api_абс, "Вызов процедур обработки", "Oracle Net")

@enduml